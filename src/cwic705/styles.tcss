/* cwic705 layout, after HAMRLOG's.
   Vertical stack: status line, main window (flexible), detail window, entry
   window, footer. Each window has its own frame; only the main one grows, so
   the entry stays at the same place whatever the terminal size. */

Screen {
    layout: vertical;
    background: $surface;
}

/* Exactly one row, separated by background colour rather than a border. */
#statusline {
    height: 1;
    background: $primary-darken-3;
    color: $text;
    padding: 0 1;
}

#main-frame,
#detail,
#entry {
    border: round $primary-darken-2;
    border-title-color: $accent;
    border-title-align: left;
}

/* Messages go on the entry's bottom edge, so they never take a row. */
#entry {
    border-subtitle-align: left;
    height: auto;
    background: $boost;
    padding: 0;
}

#main-frame {
    height: 1fr;
    min-height: 8;
    padding: 0;
}

#rx {
    height: 1fr;
    padding: 0 1;
    background: $surface;
}

/* The skimmer takes the receive pane's place in the same frame. */
#skim {
    height: 1fr;
    border: none;
    background: $surface;
    overflow-x: hidden;
}

#skim > .datatable--header {
    background: $panel;
    color: $text;
    text-style: bold;
}

#skim > .datatable--cursor,
#skim > .datatable--hover {
    background: $primary;
    color: $text;
    text-style: bold;
}

/* Three lines of detail inside the frame. */
#detail {
    height: 5;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    background: $surface;
}

#entry-row {
    height: 1;
    width: 100%;
}

#entry-label {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    text-style: bold;
}

#entry-input {
    border: none;
    height: 1;
    width: 1fr;
    padding: 0 1;
    background: $boost;
}

#entry-input:focus {
    background: $primary-darken-2;
    text-style: bold;
}

#stats {
    height: 1;
    background: $panel;
    padding: 0 1;
}
